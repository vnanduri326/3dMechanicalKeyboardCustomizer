              "title": "Sort By"
            },
            "description": "Sort order: 'price_asc', 'price_desc', 'name_asc', or 'name_desc'"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Number of results per page",
              "default": 20,
              "title": "Limit"
            },
            "description": "Number of results per page"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
